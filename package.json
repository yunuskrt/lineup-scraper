{
  "name": "lineup-scraper",
  "version": "0.0.1",
  "description": "Offline ETL for the Lineup match pool",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "oxlint --type-aware src/",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,ts}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,ts}\"",
    "noop": "tsx src/noop/main.ts",
    "pool": "tsx src/pool/main.ts",
    "resolve": "tsx src/resolve/main.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:check": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "schemas": "tsx src/raw/export.ts && tsx src/pool/export.ts",
    "lineups": "tsx src/lineups/main.ts",
    "aliases": "tsx src/aliases/main.ts",
    "scores": "tsx src/score/main.ts",
    "gate": "tsx src/gate/main.ts",
    "dataset": "tsx src/dataset/main.ts",
    "load": "tsx src/load/main.ts",
    "storage": "tsx src/storage/main.ts",
    "images": "tsx src/images/main.ts",
    "build": "tsx src/build/main.ts",
    "verify": "tsx src/verify/main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "sharp": "0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
