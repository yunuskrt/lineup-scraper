# The Neon branch to read and write
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full
# ingest (default), disposable or production; never dev
LOAD_TARGET=ingest

# Object storage on the same branch (S17): Connect → Storage
AWS_ENDPOINT_URL_S3=https://BRANCH_ID.storage.c-N.REGION.aws.neon.tech
AWS_ACCESS_KEY_ID=nak_live_...
AWS_SECRET_ACCESS_KEY=nsk_live_...
AWS_REGION=eu-central-1
STORAGE_BUCKET=images
