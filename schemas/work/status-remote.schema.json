{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "validated": {
      "type": "object",
      "properties": {
        "match": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        },
        "player": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        }
      },
      "required": [
        "match",
        "player"
      ],
      "additionalProperties": false
    },
    "errors": {
      "type": "object",
      "properties": {
        "match": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "match"
      ],
      "additionalProperties": false
    },
    "uploaded": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "crest": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9]+$"
              }
            },
            "photo": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9]+$"
              }
            }
          },
          "required": [
            "crest",
            "photo"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "ingested": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "match": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9]+$"
              }
            },
            "player": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9]+$"
              }
            },
            "crest": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9]+$"
              }
            },
            "photo": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9]+$"
              }
            }
          },
          "required": [
            "match",
            "player",
            "crest",
            "photo"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "validated",
    "errors",
    "uploaded",
    "ingested",
    "notes"
  ],
  "additionalProperties": false
}
