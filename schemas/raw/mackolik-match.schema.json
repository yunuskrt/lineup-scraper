{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "const": "mackolik"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "sourceUrl": {
      "type": "string",
      "pattern": "^https?:\\/\\/\\S+$"
    },
    "fetchedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "competition": {
      "type": "string",
      "minLength": 1
    },
    "season": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "date": {
      "type": "string",
      "minLength": 1
    },
    "home": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sourceId",
        "name"
      ],
      "additionalProperties": false
    },
    "away": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sourceId",
        "name"
      ],
      "additionalProperties": false
    },
    "score": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "source",
    "sourceId",
    "sourceUrl",
    "fetchedAt",
    "competition",
    "season",
    "stage",
    "date",
    "home",
    "away",
    "score"
  ],
  "additionalProperties": false
}
