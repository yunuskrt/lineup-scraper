{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "const": "transfermarkt"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "sourceUrl": {
      "type": "string",
      "pattern": "^https?:\\/\\/\\S+$"
    },
    "fetchedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "round": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "result": {
      "type": "string",
      "minLength": 1
    },
    "resultNote": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "home": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "crestUrl": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^https?:\\/\\/\\S+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "tablePosition": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "formation": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "starters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "profilePath": {
                "type": "string",
                "pattern": "^\\/[A-Za-z0-9_.%-]+\\/profil\\/spieler\\/[0-9]+$"
              },
              "shirtNumber": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "style": {
                "type": "string",
                "minLength": 1
              },
              "isCaptain": {
                "type": "boolean"
              }
            },
            "required": [
              "sourceId",
              "name",
              "profilePath",
              "shirtNumber",
              "style",
              "isCaptain"
            ],
            "additionalProperties": false
          }
        },
        "bench": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "shirtNumber": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "position": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "sourceId",
              "name",
              "shirtNumber",
              "position"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sourceId",
        "name",
        "crestUrl",
        "tablePosition",
        "formation",
        "starters",
        "bench"
      ],
      "additionalProperties": false
    },
    "away": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "crestUrl": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^https?:\\/\\/\\S+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "tablePosition": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "formation": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "starters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "profilePath": {
                "type": "string",
                "pattern": "^\\/[A-Za-z0-9_.%-]+\\/profil\\/spieler\\/[0-9]+$"
              },
              "shirtNumber": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "style": {
                "type": "string",
                "minLength": 1
              },
              "isCaptain": {
                "type": "boolean"
              }
            },
            "required": [
              "sourceId",
              "name",
              "profilePath",
              "shirtNumber",
              "style",
              "isCaptain"
            ],
            "additionalProperties": false
          }
        },
        "bench": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "shirtNumber": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "position": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "sourceId",
              "name",
              "shirtNumber",
              "position"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sourceId",
        "name",
        "crestUrl",
        "tablePosition",
        "formation",
        "starters",
        "bench"
      ],
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "box": {
            "type": "string",
            "enum": [
              "goal",
              "card",
              "substitution"
            ]
          },
          "side": {
            "type": "string",
            "enum": [
              "home",
              "away"
            ]
          },
          "clock": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "addedTime": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "players": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceId": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "sourceId",
                "name"
              ],
              "additionalProperties": false
            }
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "box",
          "side",
          "clock",
          "addedTime",
          "players",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "shootout": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "side": {
            "type": "string",
            "enum": [
              "home",
              "away"
            ]
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "side",
          "outcome"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "source",
    "sourceId",
    "sourceUrl",
    "fetchedAt",
    "round",
    "date",
    "result",
    "resultNote",
    "home",
    "away",
    "events",
    "shootout"
  ],
  "additionalProperties": false
}
