{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "const": "transfermarkt"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "sourceUrl": {
      "type": "string",
      "pattern": "^https?:\\/\\/\\S+$"
    },
    "fetchedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "headline": {
      "type": "string",
      "minLength": 1
    },
    "dateOfBirth": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "citizenship": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "position": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "fullName": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "nameInHomeCountry": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "capsGoals": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "source",
    "sourceId",
    "sourceUrl",
    "fetchedAt",
    "headline",
    "dateOfBirth",
    "citizenship",
    "position",
    "fullName",
    "nameInHomeCountry",
    "capsGoals"
  ],
  "additionalProperties": false
}
