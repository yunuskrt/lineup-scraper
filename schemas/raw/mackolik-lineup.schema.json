{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "const": "mackolik"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "sourceUrl": {
      "type": "string",
      "pattern": "^https?:\\/\\/\\S+$"
    },
    "fetchedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "score": {
      "type": "object",
      "properties": {
        "s": {
          "type": [
            "string",
            "null"
          ]
        },
        "st": {
          "type": [
            "string",
            "null"
          ]
        },
        "ht": {
          "type": [
            "string",
            "null"
          ]
        },
        "ft": {
          "type": [
            "string",
            "null"
          ]
        },
        "et": {
          "type": [
            "string",
            "null"
          ]
        },
        "pt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "s",
        "st",
        "ht",
        "ft",
        "et",
        "pt"
      ],
      "additionalProperties": false
    },
    "home": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "shirtNumber": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "sourceId",
          "name",
          "shirtNumber"
        ],
        "additionalProperties": false
      }
    },
    "away": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "shirtNumber": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "sourceId",
          "name",
          "shirtNumber"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "side": {
            "anyOf": [
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": 2
              }
            ]
          },
          "minute": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "type": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "playerSourceId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "playerName": {
            "type": [
              "string",
              "null"
            ]
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "detailName": {
            "type": [
              "string",
              "null"
            ]
          },
          "assistSourceId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "assistName": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "side",
          "minute",
          "type",
          "playerSourceId",
          "playerName",
          "detail",
          "detailName",
          "assistSourceId",
          "assistName"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "source",
    "sourceId",
    "sourceUrl",
    "fetchedAt",
    "score",
    "home",
    "away",
    "events"
  ],
  "additionalProperties": false
}
